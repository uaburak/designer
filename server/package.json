{
  "name": "designer-server",
  "private": true,
  "description": "DesignerV2's multiplayer server on Cloudflare (docs/multiplayer.md)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply designer --local",
    "db:migrate": "wrangler d1 migrations apply designer --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.149.0"
  }
}
