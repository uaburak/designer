// The multiplayer server (docs/multiplayer.md). Secrets (never here): wrangler secret put SESSION_SECRET,
// GOOGLE_CLIENT_SECRET. Local development reads server/.dev.vars (git-ignored).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "designer",
  "account_id": "dd8b9e757657d35f82adff075509b048",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // @node-saml/node-saml (SAML SSO, docs/multiplayer.md §15.3): Buffer, zlib, crypto.X509Certificate
  "compatibility_flags": ["nodejs_compat"],
  // The SAML libraries as their own module, imported only by SAML routes (src/auth/saml/lib.js): built before every
  // deploy/dev, uploaded next to the bundle unbundled — no other request's isolate parses their 1.2 MB
  "build": { "command": "node scripts/build-saml.mjs" },
  "find_additional_modules": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.gen.mjs"], "fallthrough": false }],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "FileRoom" },
      // One per developer preview (docs/multiplayer.md §9)
      { "name": "PREVIEWS", "class_name": "PreviewObject" },
      // One per person: live notifications to their open apps (docs/multiplayer.md §12)
      { "name": "INBOXES", "class_name": "Inbox" },
      // One per org library: its manifests, payloads and images (docs/data.md §16.2)
      { "name": "LIBRARIES", "class_name": "LibraryObject" },
      // One per organization: its shared fonts' files (docs/desktop.md §14.3)
      { "name": "FONTS", "class_name": "FontObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FileRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["PreviewObject"] },
    { "tag": "v3", "new_sqlite_classes": ["Inbox"] },
    { "tag": "v4", "new_sqlite_classes": ["LibraryObject", "FontObject"] }
  ],
  // The daily library analytics roll-up and retention sweeps at 03:17 UTC (docs/data.md §17.5), and webhook retries every
  // five minutes (docs/multiplayer.md §16.9) — two of the free plan's five
  "triggers": { "crons": ["17 3 * * *", "*/5 * * * *"] },
  // The developer preview viewer (npm run build:viewer → out/viewer/index.html), served by the Worker at /p/<id>
  // (server/src/previews.ts). The Worker runs first for every request, so the API keeps its routes.
  "assets": { "directory": "../out/viewer", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none", "not_found_handling": "none" },
  "d1_databases": [{ "binding": "DB", "database_name": "designer", "database_id": "98f2c9e2-7272-4ab0-b1ec-ee6e27b66edd", "migrations_dir": "migrations" }],
  "vars": {
    "GOOGLE_CLIENT_ID": "511486232492-8fr5pqjmcfadd334nrl6abljrran7vhl.apps.googleusercontent.com",
    // The web app (npm run web) may sign in and call the API from here
    "WEB_ORIGINS": "http://localhost:5199",
    // The server's operators (docs/multiplayer.md §17): Settings › Operator, /operator/… routes
    "OPERATOR_EMAILS": "design.burakkoc@gmail.com"
    // Optional: "GOOGLE_SITE_VERIFICATION": "google<token>.html" — Search Console's HTML-file check, served at /<that>
  },
  // Optional (docs/multiplayer.md §17): Workers Rate Limiting bindings make quota/throttle.ts count across the network
  // instead of per isolate — "ratelimits": [{ "name": "RATE_LIMIT_AUTH", "namespace_id": "1001", "simple": { "limit": 30,
  // "period": 60 } }, { "name": "RATE_LIMIT_PUBLIC", "namespace_id": "1002", "simple": { "limit": 600, "period": 60 } }]
  "observability": { "enabled": true }
}
