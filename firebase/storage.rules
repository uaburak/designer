// docs/data.md §12.6 — replace OWNER_UID with the owner's Firebase uid before `firebase deploy --only storage`.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner() { return request.auth != null && request.auth.uid == 'OWNER_UID'; }
    match /{path=**} { allow read, write: if isOwner(); }
    // Developer previews (docs/data.md §13): anyone with the link may get a file (never list); a stopped preview's
    // manifest is marked revoked before its folder is deleted.
    match /previews/{previewId}/{rest=**} { allow get: if resource.metadata.revoked != 'true'; }
  }
}
