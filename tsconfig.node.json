{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src/main/**/*", "src/preload/**/*", "src/shared/**/*", "src/store/**/*", "electron.vite.config.ts", "vite.web.config.ts", "vite.viewer.config.ts", "vite.shared.ts", "vitest.config.ts", "vitest.viewer.config.ts"]
}
