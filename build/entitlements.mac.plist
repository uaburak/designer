<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The hardened runtime's exceptions DesignerV2 needs (docs/desktop.md §12.4), for the app and its helpers
  (electron-builder.yml mac.entitlements / entitlementsInherit):
  - V8's JIT and WebAssembly (the engine, QuickJS, onnxruntime): allow-jit, allow-unsigned-executable-memory
  - the microphone, for a shared file's audio conversation (docs/multiplayer.md §11): device.audio-input
  native/haptics/haptics.node is signed with the same Developer ID, so library validation stays on.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
