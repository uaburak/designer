  RUBY = 99; SMPL = 100; TJMO = 101; TNAM = 102; TRAD = 103; VATU = 104; VJMO = 105; VKNA = 106;
  VKRN = 107; VRTR = 108; VRT2 = 109; SS01 = 110; SS02 = 111; SS03 = 112; SS04 = 113; SS05 = 114;
  SS06 = 115; SS07 = 116; SS08 = 117; SS09 = 118; SS10 = 119; SS11 = 120; SS12 = 121; SS13 = 122;
  SS14 = 123; SS15 = 124; SS16 = 125; SS17 = 126; SS18 = 127; SS19 = 128; SS20 = 129; CV01 = 130;
  CV02 = 131; CV03 = 132; CV04 = 133; CV05 = 134; CV06 = 135; CV07 = 136; CV08 = 137; CV09 = 138;
  CV10 = 139; CV11 = 140; CV12 = 141; CV13 = 142; CV14 = 143; CV15 = 144; CV16 = 145; CV17 = 146;
  CV18 = 147; CV19 = 148; CV20 = 149; CV21 = 150; CV22 = 151; CV23 = 152; CV24 = 153; CV25 = 154;
  CV26 = 155; CV27 = 156; CV28 = 157; CV29 = 158; CV30 = 159; CV31 = 160; CV32 = 161; CV33 = 162;
  CV34 = 163; CV35 = 164; CV36 = 165; CV37 = 166; CV38 = 167; CV39 = 168; CV40 = 169; CV41 = 170;
  CV42 = 171; CV43 = 172; CV44 = 173; CV45 = 174; CV46 = 175; CV47 = 176; CV48 = 177; CV49 = 178;
  CV50 = 179; CV51 = 180; CV52 = 181; CV53 = 182; CV54 = 183; CV55 = 184; CV56 = 185; CV57 = 186;
  CV58 = 187; CV59 = 188; CV60 = 189; CV61 = 190; CV62 = 191; CV63 = 192; CV64 = 193; CV65 = 194;
  CV66 = 195; CV67 = 196; CV68 = 197; CV69 = 198; CV70 = 199; CV71 = 200; CV72 = 201; CV73 = 202;
  CV74 = 203; CV75 = 204; CV76 = 205; CV77 = 206; CV78 = 207; CV79 = 208; CV80 = 209; CV81 = 210;
  CV82 = 211; CV83 = 212; CV84 = 213; CV85 = 214; CV86 = 215; CV87 = 216; CV88 = 217; CV89 = 218;
  CV90 = 219; CV91 = 220; CV92 = 221; CV93 = 222; CV94 = 223; CV95 = 224; CV96 = 225; CV97 = 226;
  CV98 = 227; CV99 = 228;
}

message FontVariation {    // variable font axis value
  uint axisTag = 1;        // OpenType tag as big-endian uint32, e.g. 'wght'
  string axisName = 2;
  float value = 3;
}

message Hyperlink {
  string url = 1;
  GUID guid = 2;           // link to a node in this file
  bool openInNewTab = 3;
}

enum LineType {
  PLAIN = 0;
  ORDERED_LIST = 1;
  UNORDERED_LIST = 2;
  // Dropped: BLOCKQUOTE=3, HEADER=4 (FigJam/Slides).
}

enum SourceDirectionality {
  AUTO = 0;
  LTR = 1;
  RTL = 2;
}

enum Directionality {
  LTR = 0;
  RTL = 1;
}

enum DirectionalityIntent {
  IMPLICIT = 0;
  EXPLICIT = 1;
}

message TextLineData {     // one per paragraph of TextData.characters
  LineType lineType = 1;
  int indentationLevel = 2;
  Directionality directionality = 3;
  DirectionalityIntent directionalityIntent = 4;
  int listStartOffset = 7;
  bool isFirstLineOfList = 8;
  SourceDirectionality sourceDirectionality = 9;
  int styleId = 10;        // paragraph style id (0 = base)
  // Reserved field numbers (2): Figma fields not kept, or reserved for future Figma fields. Never reuse.
  byte _r5 = 5 [deprecated]; byte _r6 = 6 [deprecated];
}

message TextData {         // the source of a TEXT node (one property: edits replace it whole)
  string characters = 1;   // paragraphs split by "\n"; U+2028 is a line break inside a paragraph
  uint[] characterStyleIDs = 2;        // style id per UTF-16 code unit; missing tail = 0 (base style)
  NodeChange[] styleOverrideTable = 3; // sparse run styles keyed by NodeChange.styleID (>0)
  TextLineData[] lines = 12;
  // Reserved field numbers (8): Figma fields not kept, or reserved for future Figma fields. Never reuse.
  byte _r4 = 4 [deprecated]; byte _r5 = 5 [deprecated]; byte _r6 = 6 [deprecated]; byte _r7 = 7 [deprecated]; byte _r8 = 8 [deprecated]; byte _r9 = 9 [deprecated];
  byte _r10 = 10 [deprecated]; byte _r11 = 11 [deprecated];
}

message DerivedTextData {  // text layout result (engine output)
  Vector layoutSize = 1;
  Baseline[] baselines = 2;
  Glyph[] glyphs = 3;
  Decoration[] decorations = 4;
  FontMetaData[] fontMetaData = 6;
  HyperlinkBox[] hyperlinkBoxes = 7;
  int truncationStartIndex = 8;        // -1 when not truncated
  float truncatedHeight = 9;           // -1 when not truncated
  float[] logicalIndexToCharacterOffsetMap = 10;
  DerivedTextLineData[] derivedLines = 12;
  // Reserved field numbers (2): Figma fields not kept, or reserved for future Figma fields. Never reuse.
  byte _r5 = 5 [deprecated]; byte _r11 = 11 [deprecated];
}

message DerivedTextLineData {
  Directionality directionality = 1;
}

message Baseline {
  Vector position = 1;
  float width = 2;
  float lineY = 3;
  float lineHeight = 4;
  uint firstCharacter = 5;
  uint endCharacter = 6;
  float lineAscent = 7;
  float ignoreLeadingTrim = 8;
}

message Glyph {
  uint commandsBlob = 1;   // @blob glyph outline, path commands in em units
  Vector position = 2;
  uint styleID = 3;
  float fontSize = 4;
  uint firstCharacter = 5;
  float advance = 6;
  uint[] emojiCodePoints = 7;
}

message Decoration {
  Rect[] rects = 1;
  uint styleID = 2;
}

message FontMetaData {
  FontName key = 1;
  float fontLineHeight = 2;
  byte[] fontDigest = 3;   // SHA-1 of the font file used for layout
  FontStyle fontStyle = 4;
  int fontWeight = 5;
}

message HyperlinkBox {
  Rect bounds = 1;
  string url = 2;
  GUID guid = 3;
  int hyperlinkID = 4;
  bool openInNewTab = 6;
  // Reserved field numbers (1): Figma fields not kept, or reserved for future Figma fields. Never reuse.
  byte _r5 = 5 [deprecated];
}

// ----------------------------------------------------------------------------
// Auto layout and grid
// ----------------------------------------------------------------------------

enum StackMode {
  NONE = 0;
  HORIZONTAL = 1;
  VERTICAL = 2;
  GRID = 3;
}

enum StackAlign {          // counter-axis alignment of children
  MIN = 0;
  CENTER = 1;
  MAX = 2;
  BASELINE = 3;
}

enum StackCounterAlign {   // a child's own counter-axis behaviour
  MIN = 0;
  CENTER = 1;
  MAX = 2;
  STRETCH = 3;             // "Fill container" on the counter axis
  AUTO = 4;
  BASELINE = 5;
}

enum StackJustify {        // primary-axis distribution
  MIN = 0;
  CENTER = 1;
  MAX = 2;
  SPACE_EVENLY = 3;
  SPACE_BETWEEN = 4;
  SPACE_AROUND = 5;
  SPACE_EVENLY_CSS = 6;
}

enum StackSize {
  FIXED = 0;
  RESIZE_TO_FIT = 1;                     // "Hug contents"
  RESIZE_TO_FIT_WITH_IMPLICIT_SIZE = 2;  // "Hug contents" (Figma's current encoding)
}

enum StackPositioning {
  AUTO = 0;
  ABSOLUTE = 1;            // "Ignore auto layout" (absolute position)
}

enum StackWrap {
  NO_WRAP = 0;
  WRAP = 1;
}

enum StackCounterAlignContent {
  AUTO = 0;
  SPACE_BETWEEN = 1;
}

enum GridChildAlign {
  AUTO = 0;
  MIN = 1;
  CENTER = 2;
  MAX = 3;
}

enum GridAutoTracks {
  NONE = 0;
  ROWS = 1;
}

enum GridTrackSizingType {
  FLEX = 0;                // fr
  FIXED = 1;               // px
  HUG = 2;
}

message GridTrackSizingFunction {
  GridTrackSizingType type = 1;
  float value = 2;
}

message GridTrackSize {
  GridTrackSizingFunction minSizing = 1;
  GridTrackSizingFunction maxSizing = 2;
}

message GUIDPositionMap {  // grid tracks: id + fractional position (order)
  GUIDPositionMapEntry[] entries = 1;
}

message GUIDPositionMapEntry {
  GUID id = 1;
  string position = 2;
}

message GUIDGridTrackSizeMap {
  GUIDGridTrackSizeMapEntry[] entries = 1;
}

message GUIDGridTrackSizeMapEntry {
  GUID id = 1;             // track id from gridRows/gridColumns
  GridTrackSize trackSize = 2;
}

// ----------------------------------------------------------------------------
// Prototyping
// ----------------------------------------------------------------------------

enum InteractionType {
  ON_CLICK = 0;
  AFTER_TIMEOUT = 1;       // "After delay"
  MOUSE_IN = 2;
  MOUSE_OUT = 3;
  ON_HOVER = 4;            // "While hovering"
  MOUSE_DOWN = 5;
  MOUSE_UP = 6;
  ON_PRESS = 7;            // "While pressing"
  NONE = 8;
  DRAG = 9;
  ON_KEY_DOWN = 10;        // "Key/Gamepad"
  ON_MEDIA_HIT = 12;        // "When video hits" (PrototypeEvent.mediaHitTime)
  ON_MEDIA_END = 13;        // "When video ends"
  MOUSE_ENTER = 14;
  MOUSE_LEAVE = 15;
  // Dropped: ON_VOICE=11.
}

enum ConnectionType {
  NONE = 0;
  INTERNAL_NODE = 1;       // navigate/overlay/swap/scroll to a node
  URL = 2;                 // "Open link"
  BACK = 3;
  CLOSE = 4;               // "Close overlay"
  SET_VARIABLE = 5;
  UPDATE_MEDIA_RUNTIME = 6; // the video actions (PrototypeAction.mediaAction on the video `transitionNodeID`)
  CONDITIONAL = 7;
  SET_VARIABLE_MODE = 8;
  // Dropped: OBJECT_ANIMATION=9.
}

enum MediaAction {         // UPDATE_MEDIA_RUNTIME
  PLAY = 0;                // "Play video"
  PAUSE = 1;               // "Pause video"
  TOGGLE_PLAY_PAUSE = 2;   // "Toggle play/pause"
  MUTE = 3;                // "Mute video"
  UNMUTE = 4;              // "Unmute video"
  TOGGLE_MUTE_UNMUTE = 5;  // "Toggle mute/unmute"
  SKIP_FORWARD = 6;        // "Jump forward" (mediaSkipByAmount seconds)
  SKIP_BACKWARD = 7;       // "Jump backward"
  SKIP_TO = 8;             // "Set to specific time" (mediaSkipToTime seconds)
  // Dropped: SET_PLAYBACK_RATE=9.
}

enum NavigationType {
  NAVIGATE = 0;
  OVERLAY = 1;
  SWAP = 2;                // "Swap overlay"
  SWAP_STATE = 3;          // "Change to" (interactive components)
  SCROLL_TO = 4;
}

enum TransitionType {
  INSTANT_TRANSITION = 0;
  DISSOLVE = 1;
  FADE = 2;
  SLIDE_FROM_LEFT = 3;
  SLIDE_FROM_RIGHT = 4;
  SLIDE_FROM_TOP = 5;
  SLIDE_FROM_BOTTOM = 6;
  PUSH_FROM_LEFT = 7;
  PUSH_FROM_RIGHT = 8;
  PUSH_FROM_TOP = 9;
  PUSH_FROM_BOTTOM = 10;
  MOVE_FROM_LEFT = 11;
  MOVE_FROM_RIGHT = 12;
  MOVE_FROM_TOP = 13;
  MOVE_FROM_BOTTOM = 14;
  SLIDE_OUT_TO_LEFT = 15;
  SLIDE_OUT_TO_RIGHT = 16;
  SLIDE_OUT_TO_TOP = 17;
  SLIDE_OUT_TO_BOTTOM = 18;
  MOVE_OUT_TO_LEFT = 19;
  MOVE_OUT_TO_RIGHT = 20;
  MOVE_OUT_TO_TOP = 21;
  MOVE_OUT_TO_BOTTOM = 22;
  MAGIC_MOVE = 23;
  SMART_ANIMATE = 24;
  SCROLL_ANIMATE = 25;
}

enum EasingType {
  IN_CUBIC = 0;            // "Ease in"
  OUT_CUBIC = 1;           // "Ease out"
  INOUT_CUBIC = 2;         // "Ease in and out"
  LINEAR = 3;
  IN_BACK_CUBIC = 4;
  OUT_BACK_CUBIC = 5;
  INOUT_BACK_CUBIC = 6;
  CUSTOM_CUBIC = 7;        // easingFunction = [x1, y1, x2, y2]
  SPRING = 8;
  GENTLE_SPRING = 9;
  CUSTOM_SPRING = 10;      // easingFunction = [mass, stiffness, damping, 0]
  SPRING_PRESET_ONE = 11;  // "Quick"
  SPRING_PRESET_TWO = 12;  // "Bouncy"
  SPRING_PRESET_THREE = 13;// "Slow"
  HOLD = 14;
  EASE_IN = 15;
}

enum OverlayPositionType {
  CENTER = 0;
  TOP_LEFT = 1;
  TOP_CENTER = 2;
  TOP_RIGHT = 3;
  BOTTOM_LEFT = 4;
  BOTTOM_CENTER = 5;
  BOTTOM_RIGHT = 6;
  MANUAL = 7;
}

enum OverlayBackgroundInteraction {
  NONE = 0;
  CLOSE_ON_CLICK_OUTSIDE = 1;
}

enum OverlayBackgroundType {
  NONE = 0;
  SOLID_COLOR = 1;
}

message OverlayBackgroundAppearance {
  OverlayBackgroundType backgroundType = 1;
  Color backgroundColor = 2;
}

enum ScrollDirection {     // "Overflow" of a frame in prototypes
  NONE = 0;
  HORIZONTAL = 1;
  VERTICAL = 2;
  BOTH = 3;
}

enum ScrollBehavior {      // a child's "Position" when its frame scrolls
  SCROLLS = 0;
  FIXED_WHEN_CHILD_OF_SCROLLING_FRAME = 1;
  STICKY_SCROLLS = 2;
}

enum PrototypeDeviceType {
  NONE = 0;
  PRESET = 1;
  CUSTOM = 2;
  PRESENTATION = 3;
}

enum DeviceRotation {
  NONE = 0;
  CCW_90 = 1;
}

message PrototypeDevice {
  PrototypeDeviceType type = 1;
  Vector size = 2;
  string presetIdentifier = 3;
  DeviceRotation rotation = 4;
}

message PrototypeStartingPoint {   // a flow starting point on a top-level frame
  string name = 1;
  string description = 2;
  string position = 3;             // fractional index ordering the page's flows
}

enum TriggerDevice {
  KEYBOARD = 0;
  UNKNOWN_CONTROLLER = 1;
  XBOX_ONE = 2;
  PS4 = 3;
  SWITCH_PRO = 4;
}

message KeyTrigger {
  int[] keyCodes = 1;
  TriggerDevice triggerDevice = 2;
}

message PrototypeEvent {   // the trigger
  InteractionType interactionType = 1;
  bool interactionMaintained = 2;
  float interactionDuration = 3;
  KeyTrigger keyTrigger = 4;
  float transitionTimeout = 6;     // "After delay" seconds
  float mediaHitTime = 7;          // ON_MEDIA_HIT: the video's time, seconds
  // Reserved field numbers (1): Figma fields not kept, or reserved for future Figma fields. Never reuse.
  byte _r5 = 5 [deprecated];
}

message PrototypeVariableTarget {
  VariableID id = 1;
}

message ConditionalActions {       // one branch of a Conditional; no condition = "Else"
  PrototypeAction[] actions = 1;
  VariableData condition = 2;      // BOOLEAN value, alias or EXPRESSION
}

message PrototypeAction {
  GUID transitionNodeID = 1;               // destination
  TransitionType transitionType = 2;
  float transitionDuration = 3;            // seconds
  EasingType easingType = 4;
  float transitionTimeout = 5;
  bool transitionShouldSmartAnimate = 6;
  ConnectionType connectionType = 7;
  string connectionURL = 8;
  Vector overlayRelativePosition = 9;
  NavigationType navigationType = 10;
  bool transitionPreserveScroll = 11;
  float[] easingFunction = 12;
  Vector extraScrollOffset = 13;
  bool openUrlInNewTab = 18;
  PrototypeVariableTarget targetVariable = 19;   // SET_VARIABLE target
  VariableData targetVariableData = 20;          // SET_VARIABLE value (literal, alias or EXPRESSION)
  ConditionalActions[] conditionalActions = 24;  // CONDITIONAL: if / else-if / else
  bool transitionResetScrollPosition = 25;
  bool transitionResetInteractiveComponents = 26;
  VariableSetID targetVariableSetID = 27;        // SET_VARIABLE_MODE collection
  GUID targetVariableModeID = 28;                // SET_VARIABLE_MODE mode
  MediaAction mediaAction = 16;                  // UPDATE_MEDIA_RUNTIME
  bool transitionResetVideoPosition = 17;        // "Reset video state"
  float mediaSkipToTime = 21;                    // SKIP_TO: seconds
  float mediaSkipByAmount = 22;                  // SKIP_FORWARD / SKIP_BACKWARD: seconds
  // Reserved field numbers (3): Figma fields not kept, or reserved for future Figma fields. Never reuse.
  byte _r14 = 14 [deprecated]; byte _r15 = 15 [deprecated]; byte _r23 = 23 [deprecated];
}

message PrototypeInteraction {
  GUID id = 1;
  PrototypeEvent event = 2;
  PrototypeAction[] actions = 3;   // run top to bottom
  bool isDeleted = 4;
  int stateManagementVersion = 5;
}

// ----------------------------------------------------------------------------
// Variables
// ----------------------------------------------------------------------------

message AssetRef {         // library asset reference by key (import only; DesignerV2 references by guid)
  string key = 1;
  string version = 2;
}

message VariableID {
  GUID guid = 1;
  AssetRef assetRef = 2;
}

message VariableSetID {
  GUID guid = 1;
  AssetRef assetRef = 2;
}

message StyleId {
  GUID guid = 1;
  AssetRef assetRef = 2;
}

message SymbolId {
  GUID guid = 1;
  AssetRef assetRef = 2;
}

message CodeComponentId {  // a code component; a shader paint's / effect's (Paint / Effect.customEffectId)
  GUID guid = 1;
  AssetRef assetRef = 2;
}

enum VariableDataType {
  BOOLEAN = 0;
  FLOAT = 1;
  STRING = 2;
  ALIAS = 3;
  COLOR = 4;
  EXPRESSION = 5;
  MAP = 6;                 // mapValue: RESOLVE_VARIANT's argument (variant property -> value)
  SYMBOL_ID = 7;           // instance-swap property values
  FONT_STYLE = 8;          // fontStyleValue: font style bound by name (STRING) or weight (FLOAT)
  TEXT_DATA = 9;           // text property values
  PROP_REF = 13;           // propRefValue: the field is bound to a component property
  SLOT_CONTENT_ID = 18;    // slotContentIdValue: a SLOT property's value (an instance's slot content FRAME)
  EASING = 22;             // @later Motion
  TIMING = 23;             // @later Motion (floatValue, seconds)
  // Dropped: INVALID=10, NODE_FIELD_ALIAS=11, CMS_ALIAS=12,
  // IMAGE=14, MANAGED_STRING_ALIAS=15, LINK=16, JS_RUNTIME_ALIAS=17, DATE=19,
  // KEYFRAME_*=20..21, VECTOR=24 .. TRANSITION_PARAMETER_DATA=35.
}

enum VariableResolvedDataType {
  BOOLEAN = 0;
  FLOAT = 1;
  STRING = 2;
  COLOR = 4;
  MAP = 5;
  SYMBOL_ID = 6;
  FONT_STYLE = 7;
  TEXT_DATA = 8;
  SLOT_CONTENT_ID = 12;    // resolved type of a PROP_REF to a SLOT property
  EASING = 15;             // @later
  TIMING = 16;             // @later
  // Dropped: IMAGE=9, LINK=10, JS_RUNTIME_ALIAS=11, KEYFRAME_*=13..14, VECTOR=17 .. TRANSITION_PARAMETER_DATA=28.
}

enum ExpressionFunction {
  ADDITION = 0;
  SUBTRACTION = 1;
  RESOLVE_VARIANT = 2;
  MULTIPLY = 3;
  DIVIDE = 4;
  EQUALS = 5;
  NOT_EQUAL = 6;
  LESS_THAN = 7;
  LESS_THAN_OR_EQUAL = 8;
  GREATER_THAN = 9;
  GREATER_THAN_OR_EQUAL = 10;
  AND = 11;
  OR = 12;
  NOT = 13;
  STRINGIFY = 14;
  TERNARY = 15;
  VAR_MODE_LOOKUP = 16;
  NEGATE = 17;
  IS_TRUTHY = 18;
  COMPOSE_COLOR = 20;      // [color: COLOR value or alias, opacity: FLOAT value or alias] -> COLOR
  // Dropped: KEYFRAME=19, PAINT_TO_COLOR=21, RESOLVE_LENGTH=22, TRANSITION=23.
}

message Expression {
  ExpressionFunction expressionFunction = 1;
  VariableData[] expressionArguments = 2;
}

message VariableAnyValue { // exactly one field is set, matching VariableData.dataType
  bool boolValue = 1;
  string textValue = 2;
  float floatValue = 3;
  VariableID alias = 4;
  Color colorValue = 5;
  Expression expressionValue = 6;
  VariableMap mapValue = 7;        // MAP
  SymbolId symbolIdValue = 8;
  VariableFontStyle fontStyleValue = 9;
  TextData textDataValue = 10;
  PropRefValue propRefValue = 13;
  SlotContentId slotContentIdValue = 18;  // SLOT_CONTENT_ID: the slot content an instance assigns to a SLOT property
  EasingData easingValue = 21;     // @later
  // Reserved field numbers (8): Figma fields not kept, or reserved for future Figma fields. Never reuse.
  byte _r11 = 11 [deprecated]; byte _r12 = 12 [deprecated]; byte _r14 = 14 [deprecated]; byte _r15 = 15 [deprecated]; byte _r16 = 16 [deprecated];
  byte _r17 = 17 [deprecated]; byte _r19 = 19 [deprecated]; byte _r20 = 20 [deprecated];
}

message VariableMap {              // MAP: a variant bound to variables (RESOLVE_VARIANT's one argument)
  VariableMapValue[] values = 1;
}

message VariableMapValue {
  string key = 1;                  // the VARIANT property's name
  VariableData value = 2;          // its value: an alias to a STRING / FLOAT / BOOLEAN variable (or a literal)
  GUID guidKey = 3;                // the VARIANT ComponentPropDef's id
}

message VariableFontStyle {        // font style bound to variables (FONT_STYLE)
  VariableData asString = 1;       // STRING alias: style name, e.g. "Semi Bold Italic"
  VariableData asFloat = 2;        // FLOAT alias: weight, e.g. 600
  VariableData asVariations = 3;
}

message PropRefValue {             // PROP_REF: reference to a ComponentPropDef of the enclosing component
  GUID defId = 1;
}

message SlotContentId {            // SLOT_CONTENT_ID: the FRAME (isSlotContent, under the Internal Only Canvas) a slot shows
  GUID guid = 1;
}

message VariableData {
  VariableAnyValue value = 1;
  VariableDataType dataType = 2;
  VariableResolvedDataType resolvedDataType = 3;
}

message SpringParams {     // @later
  float stiffness = 1;
  float damping = 2;
  float mass = 3;
}

message BezierHandles {    // @later
  float p1x = 1;
  float p1y = 2;
  float p2x = 3;
  float p2y = 4;
}

message TransitionEasingAnyValue { // @later
  SpringParams springEasing = 1;
  BezierHandles bezierEasing = 2;
}

message EasingData {       // @later EASING variable values
  EasingType easingType = 1;
  TransitionEasingAnyValue easingValue = 2;
}

enum VariableField {       // which node field a parameterConsumptionMap entry binds
  MISSING = 0;
  CORNER_RADIUS = 1;
  PARAGRAPH_SPACING = 2;
  PARAGRAPH_INDENT = 3;
  STROKE_WEIGHT = 4;
  STACK_SPACING = 5;
  STACK_PADDING_LEFT = 6;
  STACK_PADDING_TOP = 7;
  STACK_PADDING_RIGHT = 8;
  STACK_PADDING_BOTTOM = 9;
  VISIBLE = 10;
  TEXT_DATA = 11;
  WIDTH = 12;
  HEIGHT = 13;
  RECTANGLE_TOP_LEFT_CORNER_RADIUS = 14;
  RECTANGLE_TOP_RIGHT_CORNER_RADIUS = 15;
  RECTANGLE_BOTTOM_LEFT_CORNER_RADIUS = 16;
  RECTANGLE_BOTTOM_RIGHT_CORNER_RADIUS = 17;
  BORDER_TOP_WEIGHT = 18;
  BORDER_BOTTOM_WEIGHT = 19;
  BORDER_LEFT_WEIGHT = 20;
  BORDER_RIGHT_WEIGHT = 21;
  VARIANT_PROPERTIES = 22;
  STACK_COUNTER_SPACING = 23;
  MIN_WIDTH = 24;
  MAX_WIDTH = 25;
  MIN_HEIGHT = 26;
  MAX_HEIGHT = 27;
  FONT_FAMILY = 28;
  FONT_STYLE = 29;
  FONT_VARIATIONS = 30;
  OPACITY = 31;
  FONT_SIZE = 32;
  LETTER_SPACING = 34;
  LINE_HEIGHT = 36;
  OVERRIDDEN_SYMBOL_ID = 37;
  HYPERLINK = 38;
  SLOT_CONTENT_ID = 40;
  GRID_ROW_GAP = 41;
  GRID_COLUMN_GAP = 42;
  // Dropped: CMS_SERIALIZED_RICH_TEXT_DATA=39, X_POSITION=43 .. TEXT_ELEMENT_DELAY=76 (Sites/Motion).
}

message VariableDataMap {  // a node's parameter bindings: variables and component properties
  VariableDataMapEntry[] entries = 1;
}

message VariableDataMapEntry {
  VariableData variableData = 2;   // ALIAS, COMPOSE_COLOR EXPRESSION, FONT_STYLE or PROP_REF
  VariableField variableField = 3;
  // Reserved field numbers (1): Figma fields not kept, or reserved for future Figma fields. Never reuse.
  byte _r1 = 1 [deprecated];
}

message VariableModeBySetMap {     // explicit variable modes ("Apply variable mode")
  VariableModeBySetMapEntry[] entries = 1;
}

message VariableModeBySetMapEntry {
  VariableSetID variableSetID = 1;           // the collection (an extended collection's mode: its root collection)
  GUID variableModeID = 2;
  VariableSetID variableSetExtensionID = 3;  // an extended collection's mode: that extended collection
}

message VariableSetMode {  // one column of a collection
  GUID id = 1;
  string name = 2;
  string sortPosition = 3; // fractional index; the first mode in this order is the default mode
  VariableSetID parentVariableSetId = 4;  // an extended collection's mode: the collection it extends
  GUID parentModeId = 5;                  // ... and that collection's mode it inherits
}

message VariableDataValues {
  VariableDataValuesEntry[] entries = 1;
}

message VariableDataValuesEntry {
  GUID modeID = 1;
  VariableData variableData = 2;
}

enum VariableScope {
  ALL_SCOPES = 0;
  TEXT_CONTENT = 1;
  CORNER_RADIUS = 2;
  WIDTH_HEIGHT = 3;
  GAP = 4;
  ALL_FILLS = 5;
  FRAME_FILL = 6;
  SHAPE_FILL = 7;
  TEXT_FILL = 8;
  STROKE = 9;              // "Stroke color"
  STROKE_FLOAT = 10;
  EFFECT_FLOAT = 11;
  EFFECT_COLOR = 12;
  OPACITY = 13;
  FONT_STYLE = 14;
  FONT_FAMILY = 15;
  FONT_SIZE = 16;
  LINE_HEIGHT = 17;
  LETTER_SPACING = 18;
  PARAGRAPH_SPACING = 19;
  PARAGRAPH_INDENT = 20;
  FONT_VARIATIONS = 21;
  TRANSFORM = 22;
  COLOR_OPACITY = 23;
}

enum CodeSyntaxPlatform {
  WEB = 0;
  ANDROID = 1;
  iOS = 2;
}

message CodeSyntaxMap {
  CodeSyntaxMapEntry[] entries = 1;
}

message CodeSyntaxMapEntry {
  CodeSyntaxPlatform platform = 1;
  string value = 2;
}

// ----------------------------------------------------------------------------
// Styles, components, libraries
// ----------------------------------------------------------------------------

enum StyleType {
  NONE = 0;
  FILL = 1;                // "Color style" (ROUNDED_RECTANGLE node, fillPaints)
  TEXT = 3;                // "Text style" (TEXT node, font fields)
  EFFECT = 4;              // "Effect style" (ROUNDED_RECTANGLE node, effects)
  GRID = 6;                // "Layout guide style" (ROUNDED_RECTANGLE node, layoutGrids)
  // Dropped: STROKE=2, EXPORT=5.
}

message SymbolData {       // an instance's link to its main component
  GUID symbolID = 1;               // the SYMBOL (a local main component or a library copy)
  NodeChange[] symbolOverrides = 2;// sparse NodeChanges keyed by guidPath; empty path = instance root
  float uniformScaleFactor = 3;    // @default(1) scale tool on instances
}

enum ComponentPropType {
  BOOL = 0;                // "Boolean"
  TEXT = 1;
  INSTANCE_SWAP = 3;
  VARIANT = 4;
  SLOT = 7;
  // Dropped: COLOR=2, NUMBER=5, IMAGE=6, EASING=8, COLOR_ARRAY=9 .. (code/Sites parameters).
}

message ComponentPropValue {
  bool boolValue = 1;
  TextData textValue = 2;
  GUID guidValue = 3;      // INSTANCE_SWAP: a SYMBOL; SLOT: the slot content FRAME (isSlotContent)
  float floatValue = 4;    // a shader's NUMBER parameter (its COLOR ones are the assignment's varValue)
}

message ComponentPropDef {
  GUID id = 1;
  string name = 2;
  ComponentPropValue initialValue = 3;   // default value
  string sortPosition = 4;
  ComponentPropType type = 6;
  ComponentPropPreferredValues preferredValues = 8;
  VariableData varValue = 9;             // default bound to a variable / VARIANT value type
  string description = 11;
  SlotPropConfig slotPropConfig = 12;
  // Reserved field numbers (3): Figma fields not kept, or reserved for future Figma fields. Never reuse.
  byte _r5 = 5 [deprecated]; byte _r7 = 7 [deprecated]; byte _r10 = 10 [deprecated];
}

message ComponentPropAssignment {  // an instance's value for a component property
  GUID defID = 1;
  ComponentPropValue value = 2;
  VariableData varValue = 3;       // value bound to a variable
}

enum InstanceSwapPreferredValueType {
  COMPONENT = 0;
  STATE_GROUP = 1;
}

message InstanceSwapPreferredValue {
  InstanceSwapPreferredValueType type = 1;
  string key = 2;                  // component or component set key
}

message ComponentPropPreferredValues {
  string[] stringValues = 1;
  InstanceSwapPreferredValue[] instanceSwapValues = 2;
}

message SlotPropConfig {
  bool stretchChildOnInsert = 1;   // "Fill items on counter-axis"
  bool displayByDefault = 2;       // "Display empty slots by default"
  uint minChildren = 3;
  uint maxChildren = 4;
  bool allowPreferredValuesOnly = 5;
}

message StateGroupPropertyValueOrder {
  string property = 1;
  string[] values = 2;
}

message VariantPropSpec {          // a variant's value for one VARIANT property of its set
  GUID propDefId = 1;
  string value = 2;
}

message SymbolLink {               // component documentation link
  string uri = 1;
  string displayName = 2;
  string displayText = 3;
}

message LibraryMoveInfo {          // set on a pasted copy of a published asset ("Move to this file")
  string oldKey = 1;
  string pasteFileKey = 2;
}

message LibrarySubscription {      // @ours a library enabled in this file ("Add to file")
  string libraryKey = 1;           // the library file's fileKey
  string name = 2;                 // library file name when enabled (display fallback)
}

// ----------------------------------------------------------------------------
// Pages, sections, Dev Mode
// ----------------------------------------------------------------------------

enum DocumentColorProfile {
  LEGACY = 0;              // import only (treated as SRGB)
  SRGB = 1;
  DISPLAY_P3 = 2;
}

message ThumbnailInfo {    // "Set as thumbnail"
  GUID nodeID = 1;
  string thumbnailVersion = 2;
}

enum SectionStatus {
  NONE = 0;
  BUILD = 1;               // "Ready for dev"
  COMPLETED = 2;           // "Completed"
}

message EditInfo {         // when a node (or something inside it) was last edited; Dev Mode's "Changed"
  string timestampIso8601 = 1;
  string userId = 2;
  uint lastEditedAt = 3;   // unix seconds
  uint createdAt = 4;      // unix seconds
}

message SectionStatusInfo {
  SectionStatus status = 1;
  uint lastUpdateUnixTimestamp = 2;
  string description = 3;
  string userId = 4;
  SectionStatus prevStatus = 5;
}

enum AnnotationPropertyType {
  FILL = 0;
  STROKE = 1;
  WIDTH = 2;
  HEIGHT = 3;
  MIN_WIDTH = 4;
  MIN_HEIGHT = 5;
  MAX_WIDTH = 6;
  MAX_HEIGHT = 7;
  STROKE_WIDTH = 8;
  CORNER_RADIUS = 9;
  EFFECT = 10;
  TEXT_STYLE = 11;
  TEXT_ALIGN_HORIZONTAL = 12;
  FONT_FAMILY = 13;
  FONT_SIZE = 14;
  FONT_WEIGHT = 15;
  LINE_HEIGHT = 16;
  LETTER_SPACING = 17;
  STACK_SPACING = 18;
  STACK_PADDING = 19;
  STACK_MODE = 20;
  STACK_ALIGNMENT = 21;
  OPACITY = 22;
  COMPONENT = 23;
  FONT_STYLE = 24;
  GRID_ROW_GAP = 25;
  GRID_COLUMN_GAP = 26;
  GRID_ROW_COUNT = 27;
  GRID_COLUMN_COUNT = 28;
  GRID_ROW_ANCHOR_INDEX = 29;
  GRID_COLUMN_ANCHOR_INDEX = 30;
  GRID_ROW_SPAN = 31;
  GRID_COLUMN_SPAN = 32;
}

message AnnotationProperty {
  AnnotationPropertyType type = 1;
}

message Annotation {       // Dev Mode annotation on a layer
  string label = 1;        // the note as plain text (older files: rich text as HTML)
  AnnotationProperty[] properties = 2;
  string labelV2 = 3;      // the note as markdown (the plugin API's labelMarkdown; unverified which field Figma uses)
  GUID categoryId = 4;
}

enum AnnotationCategoryPreset {
  NONE = 0;
  ACCESSIBILITY = 1;
  BEHAVIOR = 2;
  CONTENT = 3;
  DEVELOPMENT = 4;
  INTERACTION = 5;
}

enum AnnotationCategoryColor {
  YELLOW = 0;
  ORANGE = 1;
  RED = 2;
  PINK = 3;
  VIOLET = 4;
  BLUE = 5;
  TEAL = 6;
  GREEN = 7;
}

message AnnotationCategoryCustom {
  AnnotationCategoryColor color = 1;
  Color customColor = 2;
  string label = 3;
}

message AnnotationCategory {
  GUID id = 1;
  AnnotationCategoryPreset preset = 2;
  AnnotationCategoryCustom custom = 3;
}

message AnnotationCategories {
  uint version = 1;
  AnnotationCategory[] items = 2;
}

enum AnnotationMeasurementNodeSide {
  TOP = 0;
  BOTTOM = 1;
  LEFT = 2;
  RIGHT = 3;
}

message AnnotationMeasurement {    // Dev Mode measurement between two layers
  GUID id = 1;
  GUID fromNode = 2;
  GUID toNode = 3;
  AnnotationMeasurementNodeSide fromNodeSide = 4;
  bool toSameSide = 5;
  float innerOffsetRelative = 6;
  float outerOffsetFixed = 7;
  GUIDPath toNodeStablePath = 8;
  string freeText = 9;
}

// ----------------------------------------------------------------------------
// NodeChange: one node (or a patch to one node, or an override, or a text run)
// ----------------------------------------------------------------------------

// Figma Draw brushes (a BRUSH node's artwork drawn along a path stroked with it).
enum BrushType {
  STRETCH = 0;             // "Stretch brush": the artwork elongated along the stroke
  SCATTER = 1;             // "Scatter brush": the artwork repeated along the stroke
}

enum BrushOrientation {
  FORWARD = 0;
  REVERSE = 1;             // Direction "Backward"
}

message ScatterStrokeSettings {
  float gap = 1;
  float wiggle = 2;
  float angularJitter = 3;
  float rotation = 4;
  float sizeJitter = 5;
}

message StretchStrokeSettings {
  BrushOrientation orientation = 1;
}

message DynamicStrokeSettings {
  float frequency = 1;
  float wiggle = 2;
  float smoothen = 3;
}

message VariableWidthPoint {
  float position = 1;
  float ascent = 2;
  float descent = 3;
  int segmentId = 4;
}

message VideoPlayback {    // Prototype › Video
  bool autoplay = 1;
  bool mediaLoop = 2;
  bool muted = 3;
  bool showControls = 4;
  uint startTimeMs = 5;
  uint endTimeMs = 6;
}

message NodeChange {
  // --- identity and tree ---
  GUID guid = 1;                                  // @nooverride
  NodePhase phase = 2;                            // @nooverride absent = update of an existing node
  ParentIndex parentIndex = 3;                    // @own @nooverride
  NodeType type = 4;                              // @nooverride set at CREATED; changed only by the conversions in docs/schema.md section 3.2
  string name = 5;
  bool autoRename = 14;                           // TEXT: the layer name follows its characters
  uint styleID = 49;                              // @nooverride key of a styleOverrideTable entry
  GUIDPath guidPath = 111;                        // @nooverride symbolOverrides/derivedSymbolData entry address
  GUID overrideKey = 213;                         // @nooverride stable id of a node inside a component
  bool isSoftDeleted = 330;                       // @nooverride deleted asset kept for references
  GUID[] ancestorPathBeforeDeletion = 235;        // @nooverride where "Restore component" puts it back
  uint[] clearedFields = 1000;                    // @ours @patch @nooverride field ids reset to absent

  // --- layer ---
  bool visible = 6;                               // @default(true) @bind(VISIBLE)
  bool locked = 7;                                // @own
  float opacity = 8;                              // @default(1) @bind(OPACITY)
  BlendMode blendMode = 9;
  Vector size = 11;                               // @bind(WIDTH:x,HEIGHT:y) unrotated box
  Matrix transform = 12;                          // @own @default(identity) @nooverride relative to the parent node
  bool mask = 16;                                 // @nooverride "Use as mask"
  MaskType maskType = 317;
  ConstraintType horizontalConstraint = 28;       // @own @nooverride
  ConstraintType verticalConstraint = 37;         // @own @nooverride
  bool proportionsConstrained = 151;              // "Constrain proportions"
  ExportSettings[] exportSettings = 45;
  PrototypeInteraction[] prototypeInteractions = 226;
  VariableDataMap parameterConsumptionMap = 445;  // bindings of this node's fields to variables and component properties
  VariableModeBySetMap variableModeBySetMap = 316;// explicit variable modes; absent entry = Auto
  Annotation[] annotations = 369;
  AnnotationMeasurement[] measurements = 384;

  // --- fill, stroke, corners, effects ---
  Paint[] fillPaints = 38;
  Paint[] strokePaints = 39;
  float strokeWeight = 26;                        // @bind(STROKE_WEIGHT)
  StrokeAlign strokeAlign = 29;
  StrokeCap strokeCap = 30;
  StrokeJoin strokeJoin = 31;
  float miterLimit = 25;                          // @default(4)
  float[] dashPattern = 13;                       // dash, gap, dash, gap...
  float borderTopWeight = 295;                    // @bind(BORDER_TOP_WEIGHT) individual stroke weights
  float borderBottomWeight = 296;                 // @bind(BORDER_BOTTOM_WEIGHT)
  float borderLeftWeight = 297;                   // @bind(BORDER_LEFT_WEIGHT)
  float borderRightWeight = 298;                  // @bind(BORDER_RIGHT_WEIGHT)
  bool borderStrokeWeightsIndependent = 299;
  bool bordersTakeSpace = 294;                    // auto layout: "Strokes included in layout"
  float cornerRadius = 20;                        // @bind(CORNER_RADIUS)
  float rectangleTopLeftCornerRadius = 145;       // @bind(RECTANGLE_TOP_LEFT_CORNER_RADIUS)
  float rectangleTopRightCornerRadius = 146;      // @bind(RECTANGLE_TOP_RIGHT_CORNER_RADIUS)
  float rectangleBottomLeftCornerRadius = 147;    // @bind(RECTANGLE_BOTTOM_LEFT_CORNER_RADIUS)
  float rectangleBottomRightCornerRadius = 148;   // @bind(RECTANGLE_BOTTOM_RIGHT_CORNER_RADIUS)
  bool rectangleCornerRadiiIndependent = 149;
  float cornerSmoothing = 160;                    // 0..1 ("iOS" = 0.6)
  Effect[] effects = 43;
  Path[] fillGeometry = 51;                       // @derived
  Path[] strokeGeometry = 52;                     // @derived
  StyleId styleIdForFill = 332;                   // color style for fillPaints
  StyleId styleIdForStrokeFill = 333;             // color style for strokePaints
  StyleId styleIdForText = 334;                   // text style
  StyleId styleIdForEffect = 335;                 // effect style
  StyleId styleIdForGrid = 336;                   // layout guide style

  // --- shapes ---
  uint count = 10;                                // REGULAR_POLYGON / STAR point count
  float starInnerScale = 24;                      // STAR "Ratio"
  ArcData arcData = 195;                          // ELLIPSE
  VectorData vectorData = 48;                     // @nooverride VECTOR network
  VectorMirror handleMirroring = 44;
  BooleanOperation booleanOperation = 36;         // @nooverride BOOLEAN_OPERATION

  // --- containers ---
  bool frameMaskDisabled = 115;                   // true = "Clip content" off
  bool resizeToFit = 117;                         // @nooverride FRAME as a group
  LayoutGrid[] layoutGrids = 47;
  Guide[] guides = 138;
  ScrollDirection scrollDirection = 159;
  ScrollBehavior scrollBehavior = 186;            // @own
  bool sectionContentsHidden = 283;               // @nooverride
  SectionStatusInfo sectionStatusInfo = 355;      // @nooverride Dev Mode status of a SECTION/FRAME
  EditInfo editInfo = 331;                        // @nooverride last edit of the node or its subtree (Dev Mode's "Changed")

  // --- auto layout ---
  StackMode stackMode = 105;                      // @nooverride
  float stackSpacing = 107;                       // @bind(STACK_SPACING) gap between items
  float stackHorizontalPadding = 209;             // @bind(STACK_PADDING_LEFT) left padding
  float stackVerticalPadding = 210;               // @bind(STACK_PADDING_TOP) top padding
  float stackPaddingRight = 233;                  // @bind(STACK_PADDING_RIGHT)
  float stackPaddingBottom = 234;                 // @bind(STACK_PADDING_BOTTOM)
  StackSize stackPrimarySizing = 229;             // @default(RESIZE_TO_FIT_WITH_IMPLICIT_SIZE) as in Figma files
  StackSize stackCounterSizing = 221;
  StackJustify stackPrimaryAlignItems = 230;
  StackAlign stackCounterAlignItems = 231;
  StackCounterAlignContent stackCounterAlignContent = 343;
  StackWrap stackWrap = 323;                      // @nooverride
  float stackCounterSpacing = 324;                // @bind(STACK_COUNTER_SPACING) gap between wrapped rows
  bool stackReverseZIndex = 271;                  // "Canvas stacking: first on top"
  float stackChildPrimaryGrow = 232;              // @own child: 1 = "Fill container" on the primary axis
  StackCounterAlign stackChildAlignSelf = 236;    // @own @default(AUTO) child: STRETCH = "Fill container" on the counter axis
  StackPositioning stackPositioning = 269;        // @own child: ABSOLUTE = absolute position
  OptionalVector minSize = 325;                   // @bind(MIN_WIDTH:x,MIN_HEIGHT:y)
  OptionalVector maxSize = 326;                   // @bind(MAX_WIDTH:x,MAX_HEIGHT:y)
  GUIDPositionMap gridRows = 435;                 // @nooverride
  GUIDPositionMap gridColumns = 436;              // @nooverride
  GUIDGridTrackSizeMap gridRowsSizing = 475;
  GUIDGridTrackSizeMap gridColumnsSizing = 474;
  float gridRowGap = 437;                         // @bind(GRID_ROW_GAP)
  float gridColumnGap = 438;                      // @bind(GRID_COLUMN_GAP)
  GridAutoTracks gridAutoTracks = 555;
  bool gridReflowEnabled = 556;                   // auto placement: items flow row by row in layer order (anchors unused)
  GUID gridRowAnchor = 439;                       // @own @nooverride child: start row track id
  GUID gridColumnAnchor = 440;                    // @own @nooverride child: start column track id
  uint gridRowSpan = 441;                         // @own @nooverride
  uint gridColumnSpan = 442;                      // @own @nooverride
  GridChildAlign gridChildVerticalAlign = 476;    // @own
  GridChildAlign gridChildHorizontalAlign = 477;  // @own

  // --- text ---
  TextData textData = 42;                         // @bind(TEXT_DATA)
  DerivedTextData derivedTextData = 359;          // @derived
  FontName fontName = 41;                         // @default({Inter, Regular, Inter-Regular}) @bind(FONT_FAMILY:family,FONT_STYLE:style)
  float fontSize = 21;                            // @default(12) @bind(FONT_SIZE)
  Number lineHeight = 40;                         // @default({100, PERCENT}) @bind(LINE_HEIGHT)
  Number letterSpacing = 165;                     // @default({0, PERCENT}) @bind(LETTER_SPACING)
  float paragraphSpacing = 23;                    // @bind(PARAGRAPH_SPACING)
  float paragraphIndent = 22;                     // @bind(PARAGRAPH_INDENT)
  float listSpacing = 264;
  TextAlignHorizontal textAlignHorizontal = 32;
  TextAlignVertical textAlignVertical = 33;
  TextAutoResize textAutoResize = 46;
  TextTruncation textTruncation = 280;
  int maxLines = 351;
  TextWrapStyle textWrapStyle = 594;
  TextCase textCase = 34;
  TextDecoration textDecoration = 35;
  TextDecorationStyle textDecorationStyle = 416;
  Paint[] textDecorationFillPaints = 411;
  bool textDecorationSkipInk = 412;
  Number textUnderlineOffset = 413;
  Number textDecorationThickness = 415;
  LeadingTrim leadingTrim = 322;
  bool hangingPunctuation = 337;
  bool hangingList = 339;
  OpenTypeFeature[] toggledOnOTFeatures = 205;
  OpenTypeFeature[] toggledOffOTFeatures = 206;
  bool fontVariantCommonLigatures = 127;
  bool fontVariantContextualLigatures = 128;
  bool fontVariantDiscretionaryLigatures = 129;
  bool fontVariantHistoricalLigatures = 130;
  bool fontVariantOrdinal = 131;
  bool fontVariantSlashedZero = 132;
  FontVariantNumericFigure fontVariantNumericFigure = 133;
  FontVariantNumericSpacing fontVariantNumericSpacing = 134;
  FontVariantNumericFraction fontVariantNumericFraction = 135;
  FontVariantCaps fontVariantCaps = 136;
  FontVariantPosition fontVariantPosition = 137;
  FontVariation[] fontVariations = 260;           // @bind(FONT_VARIATIONS)
  bool detachOpticalSizeFromFontSize = 261;
  SemanticWeight semanticWeight = 374;
  SemanticItalic semanticItalic = 375;
  Hyperlink hyperlink = 223;                      // @bind(HYPERLINK) on a node or a text run
  bool isOverrideOverTextStyle = 376;             // text run: this run deviates from styleIdForText

  // --- brushes (Figma Draw) ---
  BrushType brushType = 452;                      // BRUSH: stretch or scatter
  GUID strokeBrushGuid = 446;                     // a path stroked with a brush: the BRUSH node
  uint64 strokeSeed = 482;                        // the brush's jitter seed
  VariableWidthPoint[] variableWidthPoints = 447;
  DynamicStrokeSettings dynamicStrokeSettings = 448;
  ScatterStrokeSettings scatterStrokeSettings = 449;
  StretchStrokeSettings stretchStrokeSettings = 450;
  Matrix[] scatterBrushTransforms = 488;          // the scatter stamps' transforms as Figma placed them
  VideoPlayback videoPlayback = 300;              // Prototype › Video (autoplay, loop, sound)

  // --- components and instances ---
  ComponentPropDef[] componentPropDefs = 266;     // @nooverride on a SYMBOL or a state group
  bool isStateGroup = 225;                        // @nooverride FRAME is a component set
  StateGroupPropertyValueOrder[] stateGroupPropertyValueOrders = 238; // @nooverride
  VariantPropSpec[] variantPropSpecs = 483;       // @nooverride on a variant SYMBOL
  SymbolData symbolData = 113;                    // @own @nooverride INSTANCE: main component + all overrides (one property)
  NodeChange[] derivedSymbolData = 125;           // @derived INSTANCE sublayer layout/geometry, keyed by guidPath
  GUID overriddenSymbolID = 143;                  // @bind(OVERRIDDEN_SYMBOL_ID) nested instance swap
  ComponentPropAssignment[] componentPropAssignments = 268; // @own
  bool propsAreBubbled = 305;                     // @nooverride nested instance exposed to the parent component
  bool isSlot = 463;                              // @nooverride FRAME inside a component is a slot
  bool isSlotContent = 495;                       // @nooverride FRAME holding an instance's slot content
  SymbolId detachedSymbolId = 342;                // @nooverride frame was detached from this component
  SymbolLink[] symbolLinks = 237;                 // @nooverride

  // --- library and publishing (assets: SYMBOL, state group, style, VARIABLE_SET, VARIABLE) ---
  bool isPublishable = 174;                       // @default(true) @nooverride false = "Hide when publishing"
  bool isSymbolPublishable = 123;                 // @default(true) @nooverride same, for SYMBOL
  string description = 318;                       // @nooverride
  string key = 319;                               // @nooverride stable 40-hex asset key (copies: the source's key)
  string version = 171;                           // @nooverride library copy: versionHash it was copied at
  string publishedVersion = 218;                  // @nooverride local asset: versionHash at its last publish
  string sourceLibraryKey = 395;                  // @nooverride library copy: fileKey of the library
  GUID publishID = 215;                           // @nooverride library copy: guid of the asset in the library
  LibraryMoveInfo libraryMoveInfo = 256;          // @nooverride
  StyleType styleType = 163;                      // @nooverride node is a style
  string sortPosition = 320;                      // @nooverride order among styles / variables / collections

  // --- variables (VARIABLE_SET, VARIABLE) ---
  VariableSetMode[] variableSetModes = 312;       // @nooverride
  VariableSetID variableSetID = 313;              // @nooverride VARIABLE: its collection
  VariableResolvedDataType variableResolvedType = 314; // @nooverride
  VariableDataValues variableDataValues = 315;    // @nooverride one value per mode
  VariableScope[] variableScopes = 353;           // @nooverride absent = [ALL_SCOPES]; empty = shown in no picker
  CodeSyntaxMap codeSyntax = 358;                 // @nooverride
  VariableID overriddenVariableId = 464;          // @nooverride VARIABLE_OVERRIDE: the (root) variable it overrides

  // --- document, pages, prototype settings ---
  Color backgroundColor = 50;                     // @nooverride CANVAS background
  float backgroundOpacity = 19;                   // @default(1) @nooverride
  bool backgroundEnabled = 15;                    // @nooverride
  bool internalOnly = 142;                        // @nooverride the hidden "Internal Only Canvas"
  bool isPageDivider = 380;                       // @nooverride
  DocumentColorProfile documentColorProfile = 349;// @nooverride DOCUMENT
  ThumbnailInfo thumbnailInfo = 466;              // @nooverride DOCUMENT
  AnnotationCategories annotationCategories = 453;// @nooverride DOCUMENT
  LibrarySubscription[] librarySubscriptions = 1001; // @ours @nooverride DOCUMENT
  PrototypeStartingPoint prototypeStartingPoint = 249; // @own @nooverride top-level FRAME: flow start
  PrototypeDevice prototypeDevice = 184;          // @nooverride CANVAS
  Color prototypeBackgroundColor = 141;           // @nooverride CANVAS
  OverlayPositionType overlayPositionType = 198;  // @nooverride frame used as an overlay
  Vector overlayRelativePosition = 199;           // @nooverride
  OverlayBackgroundInteraction overlayBackgroundInteraction = 200; // @nooverride
  OverlayBackgroundAppearance overlayBackgroundAppearance = 201;   // @nooverride
  // Reserved field numbers (796): Figma fields not kept, or reserved for future Figma fields. Never reuse.
  byte _r17 = 17 [deprecated]; byte _r18 = 18 [deprecated]; byte _r27 = 27 [deprecated]; byte _r53 = 53 [deprecated]; byte _r54 = 54 [deprecated]; byte _r55 = 55 [deprecated];
  byte _r56 = 56 [deprecated]; byte _r57 = 57 [deprecated]; byte _r58 = 58 [deprecated]; byte _r59 = 59 [deprecated]; byte _r60 = 60 [deprecated]; byte _r61 = 61 [deprecated];
  byte _r62 = 62 [deprecated]; byte _r63 = 63 [deprecated]; byte _r64 = 64 [deprecated]; byte _r65 = 65 [deprecated]; byte _r66 = 66 [deprecated]; byte _r67 = 67 [deprecated];
  byte _r68 = 68 [deprecated]; byte _r69 = 69 [deprecated]; byte _r70 = 70 [deprecated]; byte _r71 = 71 [deprecated]; byte _r72 = 72 [deprecated]; byte _r73 = 73 [deprecated];
  byte _r74 = 74 [deprecated]; byte _r75 = 75 [deprecated]; byte _r76 = 76 [deprecated]; byte _r77 = 77 [deprecated]; byte _r78 = 78 [deprecated]; byte _r79 = 79 [deprecated];
  byte _r80 = 80 [deprecated]; byte _r81 = 81 [deprecated]; byte _r82 = 82 [deprecated]; byte _r83 = 83 [deprecated]; byte _r84 = 84 [deprecated]; byte _r85 = 85 [deprecated];
