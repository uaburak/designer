// =============================================================================
// DesignerV2 document schema (Kiwi) - the single source of truth.
//
// DOCUMENT_FORMAT_VERSION = 1
//
// engine/tools/schemagen (kiwi-schema 0.5.0 API) generates from this file:
//   ${build}/generated/schema/document.kiwi.h    C++ tree codec       (compileSchemaCPP, namespace schema)
//   ${build}/generated/schema/document.stream.h  C++ visitor codec    (compileSchemaCallbackCPP, namespace schema_stream)
//   ${build}/generated/schema/node_fields.h      field registry: ids, tags, defaults, bindings
//   src/shared/schema/document.generated.ts      TS types, codec, field registry, binary schema
// `npm run engine:gen -- --check` fails when an output is stale or Figma parity breaks.
// Explanation, patch model, ids, ordering, storage mapping: docs/schema.md.
//
// It is Figma's own schema, trimmed (reference: docs/research/figma/figma-schema.kiwi
// and the Aug-2026 schema embedded in docs/research/figma/samples/sections.fig).
// Every kept definition, field name, field number, field type and enum value is
// Figma's. Rules for editing:
//   * Never renumber or retype a field. Never reuse a number.
//   * Message field ids must be <= the field count (kiwi rule), so numbers of
//     Figma fields we dropped are kept as `byte _rN = N [deprecated];` placeholders.
//     To adopt a Figma field later, replace its placeholder with Figma's real
//     declaration (same number and type).
//   * DesignerV2's own fields are numbered from 1000 in NodeChange and from 100
//     in every other Figma-derived message; own enum values start at 100.
//     Messages that Figma does not have (tagged @ours) number from 1.
//
// Field tags: a field's trailing comment starts with its tags, then free text
// (no '@' in free text). Parsed by engine/tools/schemagen:
//   @derived       computed by the engine; never in change Messages or the journal;
//                  only in snapshots that ask for it (viewer/preview snapshots).
//   @blob          uint index into Message.blobs of the enclosing Message.
//   @nooverride    may not appear in an instance override (a symbolOverrides entry).
//   @default(v)    value meant by absence when it is not the kiwi zero value.
//   @bind(F[:c],..) VariableField(s) binding this field via parameterConsumptionMap
//                  (:c = the struct component bound, e.g. WIDTH:x).
//   @own           on an INSTANCE: the instance's own value, never taken from the main
//                  component's root and never in the root override entry.
//   @patch         only in change Messages (journal, undo, apply); never stored on a node.
//   @later         kept for parity; the v1 engine stores and round-trips it but ignores it.
//   @ours          not in Figma's schema.
// =============================================================================

// ----------------------------------------------------------------------------
// Messages and node identity
// ----------------------------------------------------------------------------

enum MessageType {
  // Dropped (multiplayer/server only): JOIN_START=0, USER_CHANGES=2, JOIN_END=3, SIGNAL=4,
  // STYLE=5, STYLE_SET=6, ..., CLIENT_RENDERED=23.
  NODE_CHANGES = 1;
}

enum NodePhase {
  CREATED = 0;
  REMOVED = 1;
}

enum NodeType {
  NONE = 0;
  DOCUMENT = 1;
  CANVAS = 2;              // a page; also the hidden "Internal Only Canvas" 0:2
  GROUP = 3;               // import only: DesignerV2 writes groups as FRAME + resizeToFit (as Figma does)
  FRAME = 4;               // frames, groups (resizeToFit), component sets (isStateGroup)
  BOOLEAN_OPERATION = 5;
  VECTOR = 6;
  STAR = 7;
  LINE = 8;
  ELLIPSE = 9;
  RECTANGLE = 10;          // import only: legacy; DesignerV2 writes ROUNDED_RECTANGLE
  REGULAR_POLYGON = 11;
  ROUNDED_RECTANGLE = 12;  // "Rectangle" in the UI; also fill/effect/grid style nodes
  TEXT = 13;               // also text style nodes
  SLICE = 14;
  SYMBOL = 15;             // "Component" in the UI; variants are SYMBOLs inside a state group
  INSTANCE = 16;
  SECTION = 25;
  VARIABLE = 28;
  VARIABLE_SET = 31;       // "Collection" in the UI; also an extended collection (its modes name their parent's)
  VARIABLE_OVERRIDE = 35;  // an extended collection's own values for one inherited variable (under the internal canvas)
  BRUSH = 46;              // Figma Draw: a brush's artwork (vectorData, fill), kept on the internal canvas 0:2
  // Dropped: STICKY=17, SHAPE_WITH_TEXT=18, CONNECTOR=19, CODE_BLOCK=20, WIDGET=21, STAMP=22,
  // MEDIA=23, HIGHLIGHT=24, SECTION_OVERLAY=26, WASHI_TAPE=27, TABLE=29, TABLE_CELL=30, SLIDE=32,
  // ASSISTED_LAYOUT=33, INTERACTIVE_SLIDE_ELEMENT=34, MODULE=36,
  // SLIDE_GRID=37, SLIDE_ROW=38, RESPONSIVE_SET=39, CODE_COMPONENT=40, TEXT_PATH=41,
  // CODE_INSTANCE=42, CODE_LIBRARY=43, CODE_FILE=44, CODE_LAYER=45, MANAGED_STRING=47,
  // TRANSFORM=48, CMS_RICH_TEXT=49, REPEATER=50, JSX=51, EMBEDDED_PROTOTYPE=52, REACT_FIBER=53,
  // RESPONSIVE_NODE_SET=54, WEBPAGE=55, KEYFRAME=56, KEYFRAME_TRACK=57, ANIMATION_PRESET_INSTANCE=58.
}

struct GUID {
  uint sessionID;
  uint localID;
}

struct ParentIndex {
  GUID guid;               // parent node
  string position;         // fractional index, base-95 printable ASCII (docs/schema.md section 10)
}

struct Blob {
  byte[] bytes;
}

message Message {
  MessageType type = 1;
  uint sessionID = 2;              // editor session that produced it (0 in snapshots)
  uint ackID = 3;                  // 0 in DesignerV2 (journal seq lives in the frame header, docs/data.md 5.2)
  NodeChange[] nodeChanges = 4;
  Blob[] blobs = 6;                // geometry/image bytes referenced by blob-index fields of this Message
  int pasteID = 12;                // clipboard: random id of one copy operation
  Vector pasteOffset = 13;
  string pasteFileKey = 14;        // clipboard: fileKey of the source file
  bool pasteIsPartiallyOutsideEnclosingFrame = 19;
  GUID pastePageId = 20;
  bool isCut = 21;
  ClipboardSelectionRegion[] clipboardSelectionRegions = 33;
  uint64 sentTimestamp = 38;       // optional: ms since Unix epoch when committed
  uint derivedDataVersion = 100;   // @ours engine version of the derived fields in this Message (0/absent = none)
  // Reserved field numbers (86): Figma fields not kept, or reserved for future Figma fields. Never reuse.
  byte _r5 = 5 [deprecated]; byte _r7 = 7 [deprecated]; byte _r8 = 8 [deprecated]; byte _r9 = 9 [deprecated]; byte _r10 = 10 [deprecated]; byte _r11 = 11 [deprecated];
  byte _r15 = 15 [deprecated]; byte _r16 = 16 [deprecated]; byte _r17 = 17 [deprecated]; byte _r18 = 18 [deprecated]; byte _r22 = 22 [deprecated]; byte _r23 = 23 [deprecated];
  byte _r24 = 24 [deprecated]; byte _r25 = 25 [deprecated]; byte _r26 = 26 [deprecated]; byte _r27 = 27 [deprecated]; byte _r28 = 28 [deprecated]; byte _r29 = 29 [deprecated];
  byte _r30 = 30 [deprecated]; byte _r31 = 31 [deprecated]; byte _r32 = 32 [deprecated]; byte _r34 = 34 [deprecated]; byte _r35 = 35 [deprecated]; byte _r36 = 36 [deprecated];
  byte _r37 = 37 [deprecated]; byte _r39 = 39 [deprecated]; byte _r40 = 40 [deprecated]; byte _r41 = 41 [deprecated]; byte _r42 = 42 [deprecated]; byte _r43 = 43 [deprecated];
  byte _r44 = 44 [deprecated]; byte _r45 = 45 [deprecated]; byte _r46 = 46 [deprecated]; byte _r47 = 47 [deprecated]; byte _r48 = 48 [deprecated]; byte _r49 = 49 [deprecated];
  byte _r50 = 50 [deprecated]; byte _r51 = 51 [deprecated]; byte _r52 = 52 [deprecated]; byte _r53 = 53 [deprecated]; byte _r54 = 54 [deprecated]; byte _r55 = 55 [deprecated];
  byte _r56 = 56 [deprecated]; byte _r57 = 57 [deprecated]; byte _r58 = 58 [deprecated]; byte _r59 = 59 [deprecated]; byte _r60 = 60 [deprecated]; byte _r61 = 61 [deprecated];
  byte _r62 = 62 [deprecated]; byte _r63 = 63 [deprecated]; byte _r64 = 64 [deprecated]; byte _r65 = 65 [deprecated]; byte _r66 = 66 [deprecated]; byte _r67 = 67 [deprecated];
  byte _r68 = 68 [deprecated]; byte _r69 = 69 [deprecated]; byte _r70 = 70 [deprecated]; byte _r71 = 71 [deprecated]; byte _r72 = 72 [deprecated]; byte _r73 = 73 [deprecated];
  byte _r74 = 74 [deprecated]; byte _r75 = 75 [deprecated]; byte _r76 = 76 [deprecated]; byte _r77 = 77 [deprecated]; byte _r78 = 78 [deprecated]; byte _r79 = 79 [deprecated];
  byte _r80 = 80 [deprecated]; byte _r81 = 81 [deprecated]; byte _r82 = 82 [deprecated]; byte _r83 = 83 [deprecated]; byte _r84 = 84 [deprecated]; byte _r85 = 85 [deprecated];
  byte _r86 = 86 [deprecated]; byte _r87 = 87 [deprecated]; byte _r88 = 88 [deprecated]; byte _r89 = 89 [deprecated]; byte _r90 = 90 [deprecated]; byte _r91 = 91 [deprecated];
  byte _r92 = 92 [deprecated]; byte _r93 = 93 [deprecated]; byte _r94 = 94 [deprecated]; byte _r95 = 95 [deprecated]; byte _r96 = 96 [deprecated]; byte _r97 = 97 [deprecated];
  byte _r98 = 98 [deprecated]; byte _r99 = 99 [deprecated];
}

message ClipboardSelectionRegion {
  GUID parent = 1;
  GUID[] nodes = 2;
  Vector enclosingFrameOffset = 3;
  bool pasteIsPartiallyOutsideEnclosingFrame = 4;
  SelectionRegionFocusType focusType = 5;
}

enum SelectionRegionFocusType {
  NONE = 0;
  PRIMARY = 1;
  SECONDARY = 2;
}

// ----------------------------------------------------------------------------
// Geometry primitives
// ----------------------------------------------------------------------------

struct Color {             // 0..1 gamma-encoded components in the document color profile (sRGB or Display P3)
  float r;
  float g;
  float b;
  float a;
}

struct Vector {
  float x;
  float y;
}

struct Rect {
  float x;
  float y;
  float w;
  float h;
}

struct Matrix {            // 2x3 affine, parent space: [m00 m01 m02; m10 m11 m12]
  float m00;
  float m01;
  float m02;
  float m10;
  float m11;
  float m12;
}

struct Number {
  float value;
  NumberUnits units;
}

enum NumberUnits {
  RAW = 0;                 // lineHeight: multiple of font size (UI "140%" = RAW 1.4)
  PIXELS = 1;
  PERCENT = 2;             // lineHeight {100, PERCENT} = "Auto"; letterSpacing: % of font size
}

message OptionalVector {   // minSize/maxSize: an axis value of 0 means "no limit on this axis"
  Vector value = 1;
}

message GUIDPath {
  GUID[] guids = 1;        // overrideKeys from an instance down to a sublayer; empty = the instance itself
}

enum Axis {
  X = 0;
  Y = 1;
}

enum WindingRule {
  NONZERO = 0;
  ODD = 1;
}

message Path {             // fillGeometry/strokeGeometry entry
  WindingRule windingRule = 1;
  uint commandsBlob = 2;   // @blob path commands (docs/schema.md section 11.3)
  uint styleID = 3;
}

message VectorData {
  uint vectorNetworkBlob = 1;          // @blob vector network (docs/schema.md section 11.3)
  Vector normalizedSize = 2;           // size the network's coordinates are expressed in
  NodeChange[] styleOverrideTable = 3; // per vertex/segment/region styles, keyed by NodeChange.styleID
}

message ArcData {          // ELLIPSE arcs, pies and donuts (radians)
  float startingAngle = 1;
  float endingAngle = 2;
  float innerRadius = 3;   // 0..1 ratio
}

enum VectorMirror {
  NONE = 0;
  ANGLE = 1;
  ANGLE_AND_LENGTH = 2;
}

enum BooleanOperation {
  UNION = 0;
  INTERSECT = 1;
  SUBTRACT = 2;
  XOR = 3;                 // "Exclude"
}

// ----------------------------------------------------------------------------
// Paint, stroke, effects
// ----------------------------------------------------------------------------

enum BlendMode {
  PASS_THROUGH = 0;
  NORMAL = 1;
  DARKEN = 2;
  MULTIPLY = 3;
  LINEAR_BURN = 4;
  COLOR_BURN = 5;
  LIGHTEN = 6;
  SCREEN = 7;
  LINEAR_DODGE = 8;
  COLOR_DODGE = 9;
  OVERLAY = 10;
  SOFT_LIGHT = 11;
  HARD_LIGHT = 12;
  DIFFERENCE = 13;
  EXCLUSION = 14;
  HUE = 15;
  SATURATION = 16;
  COLOR = 17;
  LUMINOSITY = 18;
}

enum PaintType {
  SOLID = 0;
  GRADIENT_LINEAR = 1;
  GRADIENT_RADIAL = 2;
  GRADIENT_ANGULAR = 3;
  GRADIENT_DIAMOND = 4;
  IMAGE = 5;
  VIDEO = 7;               // a video fill (drawn from its poster frame, `image`, in the editor)
  PATTERN = 8;             // "Pattern": another layer of the file (sourceNodeId) tiled
  NOISE = 9;               // a noise paint (Figma Draw)
  CUSTOM = 10;             // a shader fill ("Shader"): customEffectId + componentPropAssignments
  // Dropped: EMOJI=6.
}

enum ImageScaleMode {
  STRETCH = 0;             // "Crop" in the UI
  FIT = 1;
  FILL = 2;
  TILE = 3;
}

struct ColorStop {
  Color color;
  float position;
}

message ColorStopVar {
  Color color = 1;
  VariableData colorVar = 2;
  float position = 3;
}

message Image {
  byte[] hash = 1;         // 20-byte SHA-1 of the image file bytes (PNG/JPEG/GIF/WebP)
  string name = 2;
  uint dataBlob = 3;       // @blob clipboard only: the image bytes travel inside the Message
}

message PaintFilterMessage {   // image adjustments
  float tint = 1;
  float shadows = 2;
  float highlights = 3;
  float detail = 4;
  float exposure = 5;
  float vignette = 6;
  float temperature = 7;
  float vibrance = 8;      // "Saturation" in the UI
  float contrast = 9;
  float brightness = 10;
}

message Video {
  byte[] hash = 1;         // SHA-1 of the video file (stored like images)
  string s3Url = 2;
}

message Paint {
  PaintType type = 1;
  Color color = 2;                       // SOLID; fallback when colorVar cannot be resolved
  float opacity = 3;                     // @default(1)
  bool visible = 4;                      // @default(true)
  BlendMode blendMode = 5;               // @default(NORMAL)
  ColorStop[] stops = 6;                 // gradients
  Matrix transform = 7;                  // @default(identity) gradient/image transform in the node's unit square
  Image image = 8;
  Image imageThumbnail = 9;
  ImageScaleMode imageScaleMode = 10;
  float rotation = 11;                   // image rotation in degrees (multiples of 90)
  float scale = 12;                      // @default(1) TILE scale
  PaintFilterMessage paintFilter = 14;
  uint originalImageWidth = 19;
  uint originalImageHeight = 20;
  VariableData colorVar = 21;            // binding of `color` (alias, or COMPOSE_COLOR expression)
  ColorStopVar[] stopsVar = 23;          // bindings of gradient stop colors
  byte[] thumbHash = 25;                 // ThumbHash of the image for progressive display
  VariableData opacityVar = 38;          // binding of `opacity` to a FLOAT variable
  Video video = 18;                      // VIDEO: the video file
  GUID sourceNodeId = 26;                // PATTERN: the layer tiled ("Select source…")
  float spacing = 27;                    // PATTERN: Figma's older single spacing (patternSpacing replaces it)
  PatternTileType patternTileType = 28;  // PATTERN: "Tile type"
  PatternAlignment verticalAlignment = 29;    // PATTERN: "Alignment" (the anchor point), vertical
  PatternAlignment horizontalAlignment = 30;  // PATTERN: "Alignment", horizontal
  NoiseType noiseType = 34;              // NOISE
  float density = 35;                    // NOISE
  Vector noiseSize = 36;                 // NOISE
  Vector patternSpacing = 37;            // PATTERN: "Spacing" X / Y, as a share of the tile (0.2 = 20 %)
  CodeComponentId customEffectId = 39;   // CUSTOM: the shader (a preset "By Figma": assetRef.key, docs/schema.md §5.8)
  ComponentPropAssignment[] componentPropAssignments = 40;  // CUSTOM: the shader's parameters (defID → value / varValue)
  // Reserved field numbers (11): Figma fields not kept, or reserved for future Figma fields. Never reuse.
  byte _r13 = 13 [deprecated]; byte _r15 = 15 [deprecated]; byte _r16 = 16 [deprecated]; byte _r17 = 17 [deprecated]; byte _r22 = 22 [deprecated];
  byte _r24 = 24 [deprecated]; byte _r31 = 31 [deprecated]; byte _r32 = 32 [deprecated]; byte _r33 = 33 [deprecated];
}

enum PatternTileType {
  RECTANGULAR = 0;
  HORIZONTAL_HEXAGONAL = 1;
  VERTICAL_HEXAGONAL = 2;
}

enum PatternAlignment {
  START = 0;
  CENTER = 1;
  END = 2;
}

enum StrokeAlign {
  CENTER = 0;
  INSIDE = 1;
  OUTSIDE = 2;
}

enum StrokeCap {
  NONE = 0;
  ROUND = 1;
  SQUARE = 2;
  ARROW_LINES = 3;
  ARROW_EQUILATERAL = 4;
  DIAMOND_FILLED = 5;
  TRIANGLE_FILLED = 6;
  CIRCLE_FILLED = 14;
  // Dropped: HIGHLIGHT=7, WASHI_TAPE_1..6=8..13, ERD_*=15..20 (FigJam).
}

enum StrokeJoin {
  MITER = 0;
  BEVEL = 1;
  ROUND = 2;
}

enum EffectType {
  INNER_SHADOW = 0;
  DROP_SHADOW = 1;
  FOREGROUND_BLUR = 2;     // "Layer blur"
  BACKGROUND_BLUR = 3;
  GRAIN = 6;               // "Texture"
  NOISE = 7;               // "Noise"
  GLASS = 8;               // "Glass"
  CUSTOM = 9;              // a shader effect ("Shader"): customEffectId + componentPropAssignments
  // Dropped: REPEAT=4, SYMMETRY=5 (illustration modifiers).
}

enum BlurOpType {
  NORMAL = 0;
  PROGRESSIVE = 1;
}

enum NoiseType {           // "Multi" / "Mono" / "Duo"
  MULTITONE = 0;
  MONOTONE = 1;
  DUOTONE = 2;
}

message Effect {
  EffectType type = 1;
  Color color = 2;
  Vector offset = 3;
  float radius = 4;                      // blur radius
  bool visible = 5;                      // @default(true)
  BlendMode blendMode = 6;               // @default(NORMAL)
  float spread = 7;
  bool showShadowBehindNode = 8;         // "Show behind transparent areas"
  VariableData radiusVar = 9;
  VariableData colorVar = 10;
  VariableData spreadVar = 11;
  VariableData xVar = 12;
  VariableData yVar = 13;
  BlurOpType blurOpType = 19;            // layer / background blur "Type": Uniform (NORMAL) / Progressive
  Vector startOffset = 20;               // progressive blur: where it starts (the node's box, 0..1)
  float startRadius = 21;                // progressive blur "Start" (radius = "End")
  Vector noiseSize = 22;                 // noise "Noise size" / texture "Size" (X, Y)
  bool clipToShape = 23;                 // texture "Clip to shape"
  Color secondaryColor = 24;             // noise, Duo: the second colour
  float density = 25;                    // noise "Density" (0..1)
  NoiseType noiseType = 26;              // noise "Mono" / "Duo" / "Multi"
  float opacity = 27;                    // noise, Multi: "Opacity"
  Vector endOffset = 28;                 // progressive blur: where it ends (the node's box, 0..1)
  uint seed = 29;                        // noise / texture: the random pattern
  float refractionRadius = 30;           // glass "Splay"
  float specularAngle = 31;              // glass light "Angle" (degrees)
  float specularIntensity = 32;          // glass light "Intensity" (0..1)
  float bevelSize = 33;                  // glass "Depth"
  float chromaticAberration = 34;        // glass "Dispersion" (0..1)
  float reflectionDistance = 35;         // glass (not in the panel)
  float refractionIntensity = 36;        // glass "Refraction" (0..1); "Frost" is `radius`
  CodeComponentId customEffectId = 43;   // CUSTOM: the shader (a preset "By Figma": assetRef.key, docs/schema.md §5.8)
  ComponentPropAssignment[] componentPropAssignments = 44;  // CUSTOM: the shader's parameters (defID → value / varValue)
  // Reserved field numbers (11): Figma fields not kept, or reserved for future Figma fields. Never reuse.
  byte _r14 = 14 [deprecated]; byte _r15 = 15 [deprecated]; byte _r16 = 16 [deprecated]; byte _r17 = 17 [deprecated]; byte _r18 = 18 [deprecated];
  byte _r37 = 37 [deprecated]; byte _r38 = 38 [deprecated]; byte _r39 = 39 [deprecated]; byte _r40 = 40 [deprecated]; byte _r41 = 41 [deprecated];
  byte _r42 = 42 [deprecated];
}

enum MaskType {
  ALPHA = 0;
  OUTLINE = 1;
  LUMINANCE = 2;
}

enum ConstraintType {
  MIN = 0;                 // Left / Top
  CENTER = 1;
  MAX = 2;                 // Right / Bottom
  STRETCH = 3;             // Left & Right / Top & Bottom
  SCALE = 4;
  FIXED_MIN = 5;           // import only
  FIXED_MAX = 6;           // import only
}

// ----------------------------------------------------------------------------
// Layout guides, guides, export
// ----------------------------------------------------------------------------

enum LayoutGridType {
  MIN = 0;
  CENTER = 1;
  STRETCH = 2;
  MAX = 3;
}

enum LayoutGridPattern {
  STRIPES = 0;             // columns / rows
  GRID = 1;
}

message LayoutGrid {       // "Layout guide" in the UI
  LayoutGridType type = 1;
  Axis axis = 2;
  bool visible = 3;                      // @default(true)
  int numSections = 4;
  float offset = 5;
  float sectionSize = 6;
  float gutterSize = 7;
  Color color = 8;
  LayoutGridPattern pattern = 9;
  VariableData numSectionsVar = 10;
  VariableData offsetVar = 11;
  VariableData sectionSizeVar = 12;
  VariableData gutterSizeVar = 13;
}

message Guide {            // ruler guide on a page or frame
  Axis axis = 1;
  float offset = 2;
  GUID guid = 3;
}

enum ImageType {
  PNG = 0;
  JPEG = 1;
  SVG = 2;
  PDF = 3;
  // Dropped: MP4=4, GIF=5, WEBM=6, LOTTIE=7, DOTLOTTIE=8.
}

enum ExportConstraintType {
  CONTENT_SCALE = 0;
  CONTENT_WIDTH = 1;
  CONTENT_HEIGHT = 2;
}

struct ExportConstraint {
  ExportConstraintType type;
  float value;
}

enum ExportSVGIDMode {
  IF_NEEDED = 0;
  ALWAYS = 1;
}

enum ExportColorProfile {
  DOCUMENT = 0;
  SRGB = 1;
  DISPLAY_P3_V4 = 2;
  // Dropped: CMYK=3.
}

message ExportSettings {
  string suffix = 1;
  ImageType imageType = 2;
  ExportConstraint constraint = 3;       // @default({CONTENT_SCALE, 1})
  bool svgDataName = 4;
  ExportSVGIDMode svgIDMode = 5;
  bool svgOutlineText = 6;
  bool contentsOnly = 7;
  bool svgForceStrokeMasks = 8;
  bool useAbsoluteBounds = 9;
  ExportColorProfile colorProfile = 10;
  float quality = 11;
  bool useBicubicSampler = 12;
}

// ----------------------------------------------------------------------------
// Text
// ----------------------------------------------------------------------------

struct FontName {
  string family;
  string style;
  string postscript;
}

enum TextAlignHorizontal {
  LEFT = 0;
  CENTER = 1;
  RIGHT = 2;
  JUSTIFIED = 3;
}

enum TextAlignVertical {
  TOP = 0;
  CENTER = 1;
  BOTTOM = 2;
}

enum TextAutoResize {
  NONE = 0;                // "Fixed size"
  WIDTH_AND_HEIGHT = 1;    // "Auto width"
  HEIGHT = 2;              // "Auto height"
}

enum TextTruncation {
  DISABLED = 0;
  ENDING = 1;
}

enum TextWrapStyle {
  AUTO = 0;
  BALANCE = 1;
  PRETTY = 2;
}

enum TextCase {
  ORIGINAL = 0;
  UPPER = 1;
  LOWER = 2;
  TITLE = 3;
  SMALL_CAPS = 4;
  SMALL_CAPS_FORCED = 5;
}

enum TextDecoration {
  NONE = 0;
  UNDERLINE = 1;
  STRIKETHROUGH = 2;
}

enum TextDecorationStyle {
  SOLID = 0;
  DOTTED = 1;
  WAVY = 2;
}

enum LeadingTrim {
  NONE = 0;
  CAP_HEIGHT = 1;
}

enum FontVariantNumericFigure {
  NORMAL = 0;
  LINING = 1;
  OLDSTYLE = 2;
}

enum FontVariantNumericSpacing {
  NORMAL = 0;
  PROPORTIONAL = 1;
  TABULAR = 2;
}

enum FontVariantNumericFraction {
  NORMAL = 0;
  DIAGONAL = 1;
  STACKED = 2;
}

enum FontVariantCaps {
  NORMAL = 0;
  SMALL = 1;
  ALL_SMALL = 2;
  PETITE = 3;
  ALL_PETITE = 4;
  UNICASE = 5;
  TITLING = 6;
}

enum FontVariantPosition {
  NORMAL = 0;
  SUB = 1;
  SUPER = 2;
}

enum FontStyle {
  NORMAL = 0;
  ITALIC = 1;
}

enum SemanticWeight {
  NORMAL = 0;
  BOLD = 1;
}

enum SemanticItalic {
  NORMAL = 0;
  ITALIC = 1;
}

enum OpenTypeFeature {
  PCAP = 0; C2PC = 1; CASE = 2; CPSP = 3; TITL = 4; UNIC = 5; ZERO = 6; SINF = 7; ORDN = 8;
  AFRC = 9; DNOM = 10; NUMR = 11; LIGA = 12; CLIG = 13; DLIG = 14; HLIG = 15; RLIG = 16; AALT = 17;
  CALT = 18; RCLT = 19; SALT = 20; RVRN = 21; VERT = 22; SWSH = 23; CSWH = 24; NALT = 25; CCMP = 26;
  STCH = 27; HIST = 28; SIZE = 29; ORNM = 30; ITAL = 31; RAND = 32; DTLS = 33; FLAC = 34; MGRK = 35;
  SSTY = 36; KERN = 37; FWID = 38; HWID = 39; HALT = 40; TWID = 41; QWID = 42; PWID = 43; JUST = 44;
  LFBD = 45; OPBD = 46; RTBD = 47; PALT = 48; PKNA = 49; LTRA = 50; LTRM = 51; RTLA = 52; RTLM = 53;
  ABRV = 54; ABVM = 55; ABVS = 56; VALT = 57; VHAL = 58; BLWF = 59; BLWM = 60; BLWS = 61; AKHN = 62;
  CJCT = 63; CFAR = 64; CPCT = 65; CURS = 66; DIST = 67; EXPT = 68; FALT = 69; FINA = 70; FIN2 = 71;
