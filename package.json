{
  "name": "designer-v2",
  "productName": "DesignerV2",
  "version": "0.1.0",
  "private": true,
  "description": "burakkoc.net's design tool: a Figma-like desktop app for the site's projects",
  "author": "Burak Koç",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "dev:demo": "electron-vite dev --mode demo",
    "web": "vite --config vite.web.config.ts",
    "web:demo": "vite --config vite.web.config.ts --mode demo",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --mac",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "tokens": "vite-node scripts/gen-tokens.ts",
    "icons": "vite-node scripts/gen-icons.ts",
    "engine:gen": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON engine/tools/schemagen/schemagen.ts",
    "engine:build": "node engine/tools/build.mjs wasm-release",
    "engine:build:debug": "node engine/tools/build.mjs wasm-debug",
    "engine:test": "node engine/tools/build.mjs native-test --test",
    "engine:watch": "node engine/tools/watch.mjs",
    "engine:dev": "node scripts/engine-dev.mjs",
    "engine:shot": "node scripts/engine-shot.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase": "^12.19.0",
    "globals": "^17.13.0",
    "gsap": "^3.15.0",
    "happy-dom": "^20.14.5",
    "playwright-core": "^1.63.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "kiwi-schema": "0.5.0"
  }
}
