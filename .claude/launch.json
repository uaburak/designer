{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "web",
        "--",
        "--mode",
        "demo",
        "--port",
        "5201"
      ],
      "port": 5201
    },
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "server",
        "run",
        "dev",
        "--",
        "--port",
        "8787"
      ],
      "port": 8787
    },
    {
      "name": "web-mp",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "VITE_DESIGNER_SERVER=http://localhost:8787 npx vite --config vite.web.config.ts --host 127.0.0.1"
      ],
      "port": 5199
    },
    {
      "name": "web",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npx vite --config vite.web.config.ts --port 5199 --strictPort"
      ],
      "port": 5199
    },
    {
      "name": "site",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd site && npx vite --port 5174 --strictPort"
      ],
      "port": 5174
    }
  ]
}
